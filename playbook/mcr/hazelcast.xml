        <class-name>com.hazelcast.datastore.JdbcDataStoreFactory</class-name>
        <properties>
            <property name="jdbcUrl">jdbc:postgresql://dev-rds-instance-mcdwdl-ods.cuo0reqhhfbo.ap-southeast-1.rds.amazonaws.com:5432/ods?currentSchema=ods</property>
            <property name="username">postgres</property>
            <property name="password">Ab123456</property>
        </properties>
        <shared>true</shared>
    </external-data-store>
    <external-data-store name="localstore">
        <class-name>com.hazelcast.datastore.JdbcDataStoreFactory</class-name>
        <properties>
            <property name="jdbcUrl">jdbc:postgresql://172.17.202.130:5432/ods?currentSchema=ods</property>
            <property name="username">postgres</property>
            <property name="password">Ab123456</property>
        </properties>
        <shared>true</shared>
